{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timekeeper-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timekeeper",
      "database_id": "6511ced7-55e7-416a-a566-cefb6e98b139",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "26c8be17a3ba45c3ab50f8fbe39f31aa",
      "preview_id": "<ID_OF_PREVIEW_KV_NAMESPACE_FOR_LOCAL_DEVELOPMENT>",
    },
  ],
  // Cron is UTC: 15:00 UTC is 17:00 in Africa/Johannesburg, the end of the
  // working day the entries are billed to. Change both this and TIMEZONE
  // together if the team moves zone.
  "triggers": {
    "crons": ["0 15 * * mon-fri"],
  },
  "queues": {
    "producers": [
      {
        "binding": "DAILY_POST_QUEUE",
        "queue": "daily-posts",
      },
    ],
    "consumers": [
      {
        "queue": "daily-posts",
      },
    ],
  },
}
